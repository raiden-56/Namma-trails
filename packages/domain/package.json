{
  "name": "@kt/domain",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-free marketplace business rules: booking state machine, pricing, commission, refunds, availability, RBAC catalog, shared Zod schemas.",
  "type": "module",
  "main": "./dist/index.js",
