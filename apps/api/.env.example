# ── Runtime ──
NODE_ENV=development
PORT=4000
# Comma-separated origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000
# Proxies in front of the API (so rate limits see the real visitor). 1 locally; 2 on AWS (CloudFront + load balancer).
TRUST_PROXY_HOPS=1

# ── Database / cache ──
DATABASE_URL=postgresql://kt:kt_dev_password@localhost:5433/karnataka_tourism?schema=public
REDIS_URL=redis://localhost:6379

# ── Auth ── (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_SECONDS=300
# Pepper mixed into OTP hashes.
OTP_PEPPER=change-me-otp-pepper-at-least-16

# ── Messaging ── console = log messages (non-production only)
#                aws     = Amazon SES (email) + Amazon SNS (SMS); needs MAIL_FROM
MESSAGING_PROVIDER=console
# MAIL_FROM=Namma Trails <no-reply@example.com>
# SMS to Indian numbers needs the ids from a DLT registration:
# SMS_SENDER_ID=
# SMS_DLT_ENTITY_ID=
# SMS_DLT_TEMPLATE_ID_OTP=

# ── Where short-lived data is kept ──
# postgres / memory are the local defaults. dynamodb = Amazon DynamoDB (what AWS uses).
# To try it locally: docker compose up -d dynamodb && pnpm --filter @kt/api dynamodb:local
OTP_STORE=postgres
RATE_LIMIT_STORE=memory
# DYNAMODB_ENDPOINT=http://localhost:8000
# DYNAMODB_TABLE_OTP=kt-otp
# DYNAMODB_TABLE_RATE_LIMITS=kt-rate-limits

# ── Auth rate limits per IP per minute. Production defaults: 5 (OTP/sign-up) and 10 (sign-in).
# Raised locally so repeated E2E runs do not trip them; env validation rejects loose values in staging/production.
AUTH_OTP_RATE_LIMIT_PER_MINUTE=30
AUTH_SIGNIN_RATE_LIMIT_PER_MINUTE=60

# ── Object storage (S3-compatible; Adobe S3Mock locally, accepts any credentials) ──
S3_ENDPOINT=http://localhost:9090
S3_REGION=ap-south-1
S3_ACCESS_KEY=local-dev
S3_SECRET_KEY=local-dev
S3_PUBLIC_BUCKET=kt-public
S3_PRIVATE_BUCKET=kt-private
# Put in front of every uploaded public file. Locally: the S3 stand-in. On AWS: the site
# address, so files are served by the CDN at https://<site>/media/...
MEDIA_BASE_URL=http://localhost:9090/kt-public

# ── Payments (Razorpay test keys) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Development seed data. Must be false in production.
DEMO_DATA_ENABLED=true
