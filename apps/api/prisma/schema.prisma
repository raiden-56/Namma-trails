// Karnataka tourism marketplace — relational model.
// Conventions:
//   * ids are UUIDv7 (time-ordered, index friendly); tables/columns are snake_case.
//   * money is integer paise (Int); rates are basis points (Int, 100 = 1%).
//   * instants are timestamptz (UTC); calendar dates are `date` in Asia/Kolkata.
//   * geography columns (PostGIS) are Unsupported() and queried with raw SQL.
//   * DB-level invariants that Prisma cannot express (CHECKs, exclusion
//     constraints, partial unique indexes) live in prisma/sql/constraints.sql
//     and are appended to migrations. See docs/06-data-model.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum UserStatus {
  active
  pending_verification
  suspended
  deleted
}

enum OtpChannel {
  sms
  email
}

enum OtpPurpose {
  sign_in
  sign_up
  verify_phone
  verify_email
  reset_password
}

enum PermissionScope {
  platform
  org
  self
}

enum ProviderStatus {
  draft
  submitted
  under_review
  info_requested
  approved
  rejected
  suspended
  expired
}

enum ProviderBusinessType {
  boat_operator
  hotel_resort
  homestay
  two_wheeler_rental
  car_rental
  taxi_operator
  auto_operator
  tour_guide
  adventure_operator
  tour_package_operator
  other
}

enum OrgRole {
  owner
  manager
  front_desk
  booking_coordinator
  accountant
  operator
}

enum MembershipStatus {
  invited
  active
  revoked
}

enum ApprovalStatus {
  pending
  approved
  rejected
  revoked
}

enum DocumentStatus {
  pending
  verified
  rejected
  expired
  superseded
}

enum DocumentSubject {
  business
  owner
  boat
  vehicle
  property
  person
}

enum DestinationStatus {
  draft
  onboarding
  active
  temporarily_unavailable
}

enum BookingModel {
  slot_capacity
  nightly_inventory
  time_range_rental
  assigned_trip
  assigned_person
  package
}

enum PricingModel {
  per_person
  per_unit
  per_unit_per_night
  per_unit_per_hour
  per_unit_per_day
  distance_based
  flat
}

enum ListingStatus {
  draft
  pending_review
  changes_requested
  approved
  published
  paused
  rejected
  archived
}

enum ConfirmationPolicy {
  instant
  request
}

enum ServiceLocationKind {
  primary
  boarding_point
  pickup_point
  drop_point
  meeting_point
  property
}

enum MediaVisibility {
  public
  private
}

enum SlotStatus {
  open
  closed
  weather_hold
}

enum ReservationKind {
  hold
  committed
}

enum BookingStatus {
  draft
  pending_availability
  awaiting_provider_confirmation
  awaiting_payment
  confirmed
  in_progress
  completed
  cancellation_requested
  cancelled
  refund_pending
  partially_refunded
  refunded
  failed
  expired
  disputed
}

enum TripStatus {
  planning
  checkout_in_progress
  action_required
  awaiting_providers
  confirmed
  partially_confirmed
  in_progress
  completed
  cancelled
}

enum PaymentStatus {
  created
  authorized
  captured
  failed
  refunded
  partially_refunded
}

enum RefundStatus {
  requested
  approved
  processing
  succeeded
  failed
  rejected
}

enum RefundInitiator {
  traveler
  provider
  platform
  weather
}

enum PayoutStatus {
  scheduled
  processing
  paid
  failed
  on_hold
}

enum CouponKind {
  percent
  fixed
}

enum FundingParty {
  platform
  provider
}

enum TaxRemitter {
  provider
  platform
}

enum NotificationChannel {
  email
  sms
  in_app
  push
  whatsapp
}

enum DeliveryStatus {
  queued
  sent
  delivered
  failed
  suppressed
}

enum TicketStatus {
  open
  pending_customer
  pending_provider
  escalated
  resolved
  closed
}

enum TicketPriority {
  low
  normal
  high
  urgent
}

enum TicketCategory {
  booking
  payment
  refund
  provider_complaint
  traveler_complaint
  safety_incident
  account
  other
}

enum ReviewStatus {
  published
  hidden
  flagged
}

enum CmsStatus {
  draft
  published
  archived
}

// ─────────────────────── Identity & access ───────────────────────

model User {
  id            String     @id @default(uuid(7)) @db.Uuid
  email         String?    @unique @db.Citext
  emailVerified DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  phone         String?    @unique @db.VarChar(16)
  phoneVerified DateTime?  @map("phone_verified_at") @db.Timestamptz(3)
  passwordHash  String?    @map("password_hash")
  status        UserStatus @default(active)
  lastLoginAt   DateTime?  @map("last_login_at") @db.Timestamptz(3)
  isDemo        Boolean    @default(false) @map("is_demo")
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime?  @map("deleted_at") @db.Timestamptz(3)

  profile            UserProfile?
  roles              UserRole[]
  sessions           Session[]
  memberships        ProviderMember[]       @relation("member_user")
  trips              Trip[]
  bookings           Booking[]              @relation("booking_traveler")
  favourites         Favourite[]
  reviews            Review[]
  savedTravellers    SavedTraveller[]
  emergencyContacts  EmergencyContact[]
  notifications      Notification[]
  tickets            SupportTicket[]        @relation("ticket_requester")
  assignedTickets    SupportTicket[]        @relation("ticket_assignee")
  auditLogs          AuditLog[]
  verificationEvents ProviderVerificationEvent[]
  pushDevices        PushDevice[]

  @@map("users")
}

model UserProfile {
  userId            String    @id @map("user_id") @db.Uuid
  fullName          String    @map("full_name") @db.VarChar(120)
  avatarMediaId     String?   @map("avatar_media_id") @db.Uuid
  preferredLanguage String    @default("en") @map("preferred_language") @db.VarChar(8)
  marketingOptIn    Boolean   @default(false) @map("marketing_opt_in")
  /// DPDP: when and to which notice version the user consented.
  consentVersion    String?   @map("consent_version") @db.VarChar(32)
  consentedAt       DateTime? @map("consented_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Role {
  id          String          @id @default(uuid(7)) @db.Uuid
  key         String          @unique @db.VarChar(64)
  name        String          @db.VarChar(120)
  description String?
  scope       PermissionScope @default(platform)
  isSystem    Boolean         @default(false) @map("is_system")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String          @id @default(uuid(7)) @db.Uuid
  key         String          @unique @db.VarChar(96)
  scope       PermissionScope
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Platform roles (admin roles and the traveler role). Organisation roles live on provider_members.
model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  grantedBy String?  @map("granted_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@map("user_roles")
}

/// Refresh-token sessions. Only a SHA-256 hash of the token is stored; rotation revokes the previous token.
model Session {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.VarChar(64)
  familyId         String    @map("family_id") @db.Uuid
  userAgent        String?   @map("user_agent") @db.VarChar(400)
  ipAddress        String?   @map("ip_address") @db.Inet
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

model OtpVerification {
  id          String     @id @default(uuid(7)) @db.Uuid
  channel     OtpChannel
  destination String     @db.VarChar(254)
  purpose     OtpPurpose
  codeHash    String     @map("code_hash") @db.VarChar(128)
  attempts    Int        @default(0)
  maxAttempts Int        @default(5) @map("max_attempts")
  expiresAt   DateTime   @map("expires_at") @db.Timestamptz(3)
  consumedAt  DateTime?  @map("consumed_at") @db.Timestamptz(3)
  ipAddress   String?    @map("ip_address") @db.Inet
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([destination, purpose, createdAt])
  @@map("otp_verifications")
}

model PushDevice {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  endpoint  String   @unique
  keys      Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("push_devices")
}

// ─────────────────────── Provider ecosystem ───────────────────────

model Provider {
  id                 String               @id @default(uuid(7)) @db.Uuid
  slug               String               @unique @db.VarChar(140)
  legalName          String               @map("legal_name") @db.VarChar(200)
  displayName        String               @map("display_name") @db.VarChar(120)
  businessType       ProviderBusinessType @map("business_type")
  description        String?
  registrationNumber String?              @map("registration_number") @db.VarChar(60)
  gstin              String?              @db.VarChar(15)
  contactEmail       String               @map("contact_email") @db.Citext
  contactPhone       String               @map("contact_phone") @db.VarChar(16)
  website            String?
  socialLinks        Json?                @map("social_links")
  addressLine1       String               @map("address_line1") @db.VarChar(200)
  addressLine2       String?              @map("address_line2") @db.VarChar(200)
  city               String               @db.VarChar(100)
  district           String               @db.VarChar(100)
  state              String               @default("Karnataka") @db.VarChar(100)
  pincode            String               @db.VarChar(6)
  location           Unsupported("geography(Point,4326)")?
  status             ProviderStatus       @default(draft)
  submittedAt        DateTime?            @map("submitted_at") @db.Timestamptz(3)
  approvedAt         DateTime?            @map("approved_at") @db.Timestamptz(3)
  suspendedReason    String?              @map("suspended_reason")
  ratingAvg          Decimal?             @map("rating_avg") @db.Decimal(3, 2)
  ratingCount        Int                  @default(0) @map("rating_count")
  /// Development seed data only. Demo providers are never shown in production (DEMO_DATA_ENABLED=false).
  isDemo             Boolean              @default(false) @map("is_demo")
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime?            @map("deleted_at") @db.Timestamptz(3)

  members            ProviderMember[]
  categories         ProviderCategory[]
  destinations       ProviderDestination[]
  documents          ProviderDocument[]
  verificationEvents ProviderVerificationEvent[]
  payoutAccounts     PayoutAccount[]
  services           Service[]
  inventoryItems     InventoryItem[]
  cancellationPolicies CancellationPolicy[]
  bookings           Booking[]
  payouts            Payout[]
  commissionRules    CommissionRule[]
  reviews            Review[]
  tickets            SupportTicket[]

  @@index([status])
  @@map("providers")
}

/// Staff of a provider organisation (owner, managers, front desk, operators…).
model ProviderMember {
  id                String           @id @default(uuid(7)) @db.Uuid
  providerId        String           @map("provider_id") @db.Uuid
  userId            String?          @map("user_id") @db.Uuid
  role              OrgRole
  /// Extra org permissions granted beyond the role defaults.
  extraPermissions  String[]         @default([]) @map("extra_permissions")
  status            MembershipStatus @default(invited)
  inviteEmail       String?          @map("invite_email") @db.Citext
  invitePhone       String?          @map("invite_phone") @db.VarChar(16)
  inviteTokenHash   String?          @unique @map("invite_token_hash") @db.VarChar(64)
  inviteExpiresAt   DateTime?        @map("invite_expires_at") @db.Timestamptz(3)
  displayName       String?          @map("display_name") @db.VarChar(120)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  provider    Provider          @relation(fields: [providerId], references: [id], onDelete: Cascade)
  user        User?             @relation("member_user", fields: [userId], references: [id], onDelete: Cascade)
  assignments BookingAssignment[]

  @@unique([providerId, userId])
  @@index([userId])
  @@map("provider_members")
}

model Category {
  id                 String       @id @default(uuid(7)) @db.Uuid
  key                String       @unique @db.VarChar(48)
  name               String       @db.VarChar(80)
  slug               String       @unique @db.VarChar(80)
  description        String?
  icon               String?      @db.VarChar(48)
  bookingModel       BookingModel @map("booking_model")
  defaultPricingModel PricingModel @map("default_pricing_model")
  /// JSON Schema-like descriptor of category-specific service attributes (validated in the API).
  attributeSchema    Json?        @map("attribute_schema")
  taxRemitter        TaxRemitter  @default(provider) @map("tax_remitter")
  sortOrder          Int          @default(0) @map("sort_order")
  isActive           Boolean      @default(true) @map("is_active")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  providerCategories    ProviderCategory[]
  destinationCategories DestinationCategory[]
  services              Service[]
  documentRequirements  DocumentRequirement[]
  taxRules              TaxRule[]

  @@map("categories")
}

/// A provider's application to operate in a category. Each is approved separately.
model ProviderCategory {
  providerId String         @map("provider_id") @db.Uuid
  categoryId String         @map("category_id") @db.Uuid
  status     ApprovalStatus @default(pending)
  reviewedBy String?        @map("reviewed_by") @db.Uuid
  reviewedAt DateTime?      @map("reviewed_at") @db.Timestamptz(3)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Soft delete: set when the partner drops this category. The row is kept.
  removedAt  DateTime?      @map("removed_at") @db.Timestamptz(3)

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([providerId, categoryId])
  @@index([categoryId, status])
  @@map("provider_categories")
}

model ProviderDestination {
  providerId    String    @map("provider_id") @db.Uuid
  destinationId String    @map("destination_id") @db.Uuid
  /// Soft delete: set when the partner drops this town. The row is kept.
  removedAt     DateTime? @map("removed_at") @db.Timestamptz(3)

  provider    Provider    @relation(fields: [providerId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Restrict)

  @@id([providerId, destinationId])
  @@index([destinationId])
  @@map("provider_destinations")
}

model DocumentType {
  id               String          @id @default(uuid(7)) @db.Uuid
  key              String          @unique @db.VarChar(64)
  label            String          @db.VarChar(120)
  description      String?
  subject          DocumentSubject
  requiresNumber   Boolean         @default(false) @map("requires_number")
  requiresExpiry   Boolean         @default(false) @map("requires_expiry")
  allowedMimeTypes String[]        @default(["application/pdf", "image/jpeg", "image/png"]) @map("allowed_mime_types")
  maxSizeBytes     Int             @default(10485760) @map("max_size_bytes")

  requirements DocumentRequirement[]
  documents    ProviderDocument[]

  @@map("document_types")
}

/// Which documents a category needs, optionally narrowed to a state/district (jurisdiction).
model DocumentRequirement {
  id             String   @id @default(uuid(7)) @db.Uuid
  categoryId     String   @map("category_id") @db.Uuid
  documentTypeId String   @map("document_type_id") @db.Uuid
  required       Boolean  @default(true)
  state          String?  @db.VarChar(100)
  district       String?  @db.VarChar(100)
  notes          String?
  isActive       Boolean  @default(true) @map("is_active")

  category     Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  documentType DocumentType @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)

  // Uniqueness (with NULL = "all districts") is a NULLS NOT DISTINCT index in prisma/sql/constraints.sql.
  @@index([categoryId])
  @@map("document_requirements")
}

model ProviderDocument {
  id              String         @id @default(uuid(7)) @db.Uuid
  providerId      String         @map("provider_id") @db.Uuid
  documentTypeId  String         @map("document_type_id") @db.Uuid
  /// Set for asset documents (a specific boat/vehicle/property/guide).
  inventoryItemId String?        @map("inventory_item_id") @db.Uuid
  mediaId         String         @map("media_id") @db.Uuid
  documentNumber  String?        @map("document_number") @db.VarChar(80)
  issuedOn        DateTime?      @map("issued_on") @db.Date
  expiresOn       DateTime?      @map("expires_on") @db.Date
  status          DocumentStatus @default(pending)
  rejectionReason String?        @map("rejection_reason")
  reviewedBy      String?        @map("reviewed_by") @db.Uuid
  reviewedAt      DateTime?      @map("reviewed_at") @db.Timestamptz(3)
  /// The document this upload replaces (renewal or correction).
  supersedesId    String?        @unique @map("supersedes_id") @db.Uuid
  uploadedBy      String         @map("uploaded_by") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  provider      Provider          @relation(fields: [providerId], references: [id], onDelete: Cascade)
  documentType  DocumentType      @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)
  inventoryItem InventoryItem?    @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  media         MediaAsset        @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  supersedes    ProviderDocument? @relation("doc_supersedes", fields: [supersedesId], references: [id])
  supersededBy  ProviderDocument? @relation("doc_supersedes")

  @@index([providerId, status])
  @@index([expiresOn])
  @@map("provider_documents")
}

/// Append-only history of verification decisions and messages (admin ↔ provider).
model ProviderVerificationEvent {
  id          String          @id @default(uuid(7)) @db.Uuid
  providerId  String          @map("provider_id") @db.Uuid
  actorId     String?         @map("actor_id") @db.Uuid
  event       String          @db.VarChar(64)
  fromStatus  ProviderStatus? @map("from_status")
  toStatus    ProviderStatus? @map("to_status")
  /// Visible to the provider (reason, request for information).
  message     String?
  /// Internal admin note, never shown to the provider.
  internalNote String?        @map("internal_note")
  documentId  String?         @map("document_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  actor    User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([providerId, createdAt])
  @@map("provider_verification_events")
}

model PayoutAccount {
  id                String    @id @default(uuid(7)) @db.Uuid
  providerId        String    @map("provider_id") @db.Uuid
  accountHolderName String    @map("account_holder_name") @db.VarChar(120)
  /// Bank details are stored with the gateway (e.g. linked account / fund account); we keep only references and masked values.
  gatewayAccountRef String?   @map("gateway_account_ref") @db.VarChar(80)
  bankAccountLast4  String?   @map("bank_account_last4") @db.VarChar(4)
  ifsc              String?   @db.VarChar(11)
  upiVpaMasked      String?   @map("upi_vpa_masked") @db.VarChar(80)
  verifiedAt        DateTime? @map("verified_at") @db.Timestamptz(3)
  isPrimary         Boolean   @default(false) @map("is_primary")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  payouts  Payout[]

  @@map("payout_accounts")
}

// ────────────────────────── Marketplace ──────────────────────────

model Destination {
  id               String            @id @default(uuid(7)) @db.Uuid
  slug             String            @unique @db.VarChar(80)
  name             String            @db.VarChar(120)
  state            String            @default("Karnataka") @db.VarChar(100)
  district         String            @db.VarChar(100)
  tagline          String?           @db.VarChar(200)
  summary          String?
  /// Rich editorial content (sections, travel tips, best time to visit) as structured blocks.
  content          Json?
  location         Unsupported("geography(Point,4326)")?
  boundary         Unsupported("geography(MultiPolygon,4326)")?
  coverMediaId     String?           @map("cover_media_id") @db.Uuid
  status           DestinationStatus @default(draft)
  isFeatured       Boolean           @default(false) @map("is_featured")
  launchPhase      Int               @default(1) @map("launch_phase")
  sortOrder        Int               @default(0) @map("sort_order")
  seoTitle         String?           @map("seo_title") @db.VarChar(70)
  seoDescription   String?           @map("seo_description") @db.VarChar(170)
  launchedAt       DateTime?         @map("launched_at") @db.Timestamptz(3)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  categories  DestinationCategory[]
  attractions Attraction[]
  providers   ProviderDestination[]
  services    Service[]
  faqs        Faq[]
  gallery     DestinationMedia[]

  @@index([status])
  @@map("destinations")
}

/// Category enablement and launch readiness per destination.
model DestinationCategory {
  destinationId     String   @map("destination_id") @db.Uuid
  categoryId        String   @map("category_id") @db.Uuid
  isEnabled         Boolean  @default(false) @map("is_enabled")
  /// Minimum approved, published listings before this category is shown as available.
  minVerifiedListings Int    @default(1) @map("min_verified_listings")
  sortOrder         Int      @default(0) @map("sort_order")

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([destinationId, categoryId])
  @@map("destination_categories")
}

model DestinationMedia {
  destinationId String @map("destination_id") @db.Uuid
  mediaId       String @map("media_id") @db.Uuid
  sortOrder     Int    @default(0) @map("sort_order")
  caption       String? @db.VarChar(200)

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  media       MediaAsset  @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([destinationId, mediaId])
  @@map("destination_media")
}

model Attraction {
  id            String   @id @default(uuid(7)) @db.Uuid
  destinationId String   @map("destination_id") @db.Uuid
  slug          String   @db.VarChar(120)
  name          String   @db.VarChar(160)
  summary       String?
  content       Json?
  location      Unsupported("geography(Point,4326)")?
  coverMediaId  String?  @map("cover_media_id") @db.Uuid
  sortOrder     Int      @default(0) @map("sort_order")
  isPublished   Boolean  @default(false) @map("is_published")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([destinationId, slug])
  @@map("attractions")
}

model Service {
  id                   String             @id @default(uuid(7)) @db.Uuid
  providerId           String             @map("provider_id") @db.Uuid
  categoryId           String             @map("category_id") @db.Uuid
  destinationId        String             @map("destination_id") @db.Uuid
  slug                 String             @unique @db.VarChar(160)
  title                String             @db.VarChar(160)
  summary              String?            @db.VarChar(300)
  description          String?
  highlights           String[]           @default([])
  inclusions           String[]           @default([])
  exclusions           String[]           @default([])
  /// Category-specific attributes (boat type, route, meal plans, vehicle class…), validated per category.
  attributes           Json               @default("{}")
  languages            String[]           @default([])
  durationMinutes      Int?               @map("duration_minutes")
  minParticipants      Int                @default(1) @map("min_participants")
  maxParticipants      Int?               @map("max_participants")
  minAge               Int?               @map("min_age")
  safetyInfo           String?            @map("safety_info")
  weatherDependent     Boolean            @default(false) @map("weather_dependent")
  requiresLicence      Boolean            @default(false) @map("requires_licence")
  confirmationPolicy   ConfirmationPolicy @default(instant) @map("confirmation_policy")
  providerResponseMins Int                @default(720) @map("provider_response_mins")
  minLeadMinutes       Int                @default(120) @map("min_lead_minutes")
  maxAdvanceDays       Int                @default(180) @map("max_advance_days")
  cancellationPolicyId String?            @map("cancellation_policy_id") @db.Uuid
  status               ListingStatus      @default(draft)
  /// Denormalised "from" price for search sorting; recomputed when price plans change.
  fromPrice            Int?               @map("from_price")
  ratingAvg            Decimal?           @map("rating_avg") @db.Decimal(3, 2)
  ratingCount          Int                @default(0) @map("rating_count")
  viewCount            Int                @default(0) @map("view_count")
  isFeatured           Boolean            @default(false) @map("is_featured")
  isPromoted           Boolean            @default(false) @map("is_promoted")
  publishedAt          DateTime?          @map("published_at") @db.Timestamptz(3)
  isDemo               Boolean            @default(false) @map("is_demo")
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt            DateTime?          @map("deleted_at") @db.Timestamptz(3)

  provider           Provider            @relation(fields: [providerId], references: [id], onDelete: Restrict)
  category           Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  destination        Destination         @relation(fields: [destinationId], references: [id], onDelete: Restrict)
  cancellationPolicy CancellationPolicy? @relation(fields: [cancellationPolicyId], references: [id], onDelete: SetNull)
  media              ServiceMedia[]
  locations          ServiceLocation[]
  tags               ServiceTag[]
  reviewEvents       ServiceReviewEvent[]
  inventoryItems     InventoryItem[]
  pricePlans         PricePlan[]
  availabilityRules  AvailabilityRule[]
  blackoutDates      BlackoutDate[]
  bookings           Booking[]
  favourites         Favourite[]
  reviews            Review[]

  @@index([destinationId, categoryId, status])
  @@index([providerId, status])
  @@index([status, fromPrice])
  @@map("services")
}

model ServiceMedia {
  serviceId String  @map("service_id") @db.Uuid
  mediaId   String  @map("media_id") @db.Uuid
  sortOrder Int     @default(0) @map("sort_order")
  caption   String? @db.VarChar(200)
  isCover   Boolean @default(false) @map("is_cover")
  approved  Boolean @default(false)

  service Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  media   MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([serviceId, mediaId])
  @@map("service_media")
}

model ServiceLocation {
  id           String              @id @default(uuid(7)) @db.Uuid
  serviceId    String              @map("service_id") @db.Uuid
  kind         ServiceLocationKind
  name         String              @db.VarChar(160)
  addressLine  String?             @map("address_line") @db.VarChar(240)
  instructions String?
  location     Unsupported("geography(Point,4326)")
  sortOrder    Int                 @default(0) @map("sort_order")

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@map("service_locations")
}

model Tag {
  id   String @id @default(uuid(7)) @db.Uuid
  key  String @unique @db.VarChar(48)
  name String @db.VarChar(80)

  services ServiceTag[]

  @@map("tags")
}

model ServiceTag {
  serviceId String @map("service_id") @db.Uuid
  tagId     String @map("tag_id") @db.Uuid

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([serviceId, tagId])
  @@map("service_tags")
}

/// Listing moderation history (submit, approve, request changes, reject, disable).
model ServiceReviewEvent {
  id         String         @id @default(uuid(7)) @db.Uuid
  serviceId  String         @map("service_id") @db.Uuid
  actorId    String?        @map("actor_id") @db.Uuid
  event      String         @db.VarChar(64)
  fromStatus ListingStatus? @map("from_status")
  toStatus   ListingStatus? @map("to_status")
  message    String?
  internalNote String?      @map("internal_note")
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, createdAt])
  @@map("service_review_events")
}

model CancellationPolicy {
  id                    String   @id @default(uuid(7)) @db.Uuid
  /// Null for platform presets (Flexible / Moderate / Strict).
  providerId            String?  @map("provider_id") @db.Uuid
  name                  String   @db.VarChar(80)
  /// [{ minHoursBeforeStart, refundBps }]
  tiers                 Json
  platformFeeRefundable Boolean  @default(false) @map("platform_fee_refundable")
  summary               String
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  provider Provider? @relation(fields: [providerId], references: [id], onDelete: Cascade)
  services Service[]

  @@map("cancellation_policies")
}

model MediaAsset {
  id          String          @id @default(uuid(7)) @db.Uuid
  bucket      String          @db.VarChar(63)
  objectKey   String          @unique @map("object_key") @db.VarChar(512)
  visibility  MediaVisibility
  mimeType    String          @map("mime_type") @db.VarChar(100)
  sizeBytes   Int             @map("size_bytes")
  sha256      String          @db.VarChar(64)
  width       Int?
  height      Int?
  altText     String?         @map("alt_text") @db.VarChar(240)
  uploadedBy  String?         @map("uploaded_by") @db.Uuid
  /// Upload is only usable after the server has verified type/size/checksum.
  verifiedAt  DateTime?       @map("verified_at") @db.Timestamptz(3)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt   DateTime?       @map("deleted_at") @db.Timestamptz(3)

  serviceMedia     ServiceMedia[]
  destinationMedia DestinationMedia[]
  documents        ProviderDocument[]

  @@map("media_assets")
}

// ─────────────────── Inventory & availability ───────────────────

/// A sellable unit pool or resource: a room type (N rooms), a boat, a fleet of scooters, a guide, a cab.
model InventoryItem {
  id              String   @id @default(uuid(7)) @db.Uuid
  providerId      String   @map("provider_id") @db.Uuid
  serviceId       String   @map("service_id") @db.Uuid
  name            String   @db.VarChar(120)
  /// Units in the pool (rooms of this type, scooters of this model). 1 for an individual boat/cab/guide.
  totalUnits      Int      @default(1) @map("total_units")
  /// Seats per unit (boat/cab) or max occupancy per room.
  capacity        Int      @default(1)
  turnaroundMins  Int      @default(0) @map("turnaround_mins")
  /// Language codes (guides) or vehicle class tags used for matching.
  tags            String[] @default([])
  attributes      Json     @default("{}")
  /// Staff member assigned to operate this resource (driver, boatman, guide).
  operatorMemberId String? @map("operator_member_id") @db.Uuid
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  provider     Provider              @relation(fields: [providerId], references: [id], onDelete: Cascade)
  service      Service               @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  documents    ProviderDocument[]
  slots        AvailabilitySlot[]
  dayOverrides InventoryDayOverride[]
  reservations InventoryReservation[]
  pricePlans   PricePlan[]

  @@index([serviceId])
  @@map("inventory_items")
}

/// Recurring schedule used to generate slots (slot_capacity) or define operating hours.
model AvailabilityRule {
  id            String    @id @default(uuid(7)) @db.Uuid
  serviceId     String    @map("service_id") @db.Uuid
  daysOfWeek    Int[]     @map("days_of_week")
  /// Departure / session start times "HH:mm" (IST) for slot-based services.
  startTimes    String[]  @default([]) @map("start_times")
  openTime      String?   @map("open_time") @db.VarChar(5)
  closeTime     String?   @map("close_time") @db.VarChar(5)
  validFrom     DateTime  @map("valid_from") @db.Date
  validTo       DateTime? @map("valid_to") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("availability_rules")
}

/// Concrete departure/session with capacity counters. Counters are changed only under SELECT … FOR UPDATE and guarded by CHECKs.
model AvailabilitySlot {
  id              String     @id @default(uuid(7)) @db.Uuid
  inventoryItemId String     @map("inventory_item_id") @db.Uuid
  date            DateTime   @db.Date
  startsAt        DateTime   @map("starts_at") @db.Timestamptz(3)
  endsAt          DateTime   @map("ends_at") @db.Timestamptz(3)
  capacity        Int
  committed       Int        @default(0)
  held            Int        @default(0)
  privatelyBooked Boolean    @default(false) @map("privately_booked")
  status          SlotStatus @default(open)
  statusReason    String?    @map("status_reason")
  version         Int        @default(0)

  inventoryItem InventoryItem          @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  reservations  InventoryReservation[]

  @@unique([inventoryItemId, startsAt])
  @@index([date, status])
  @@map("availability_slots")
}

/// Per-date unit overrides / closures for nightly inventory.
model InventoryDayOverride {
  inventoryItemId String   @map("inventory_item_id") @db.Uuid
  date            DateTime @db.Date
  totalUnits      Int?     @map("total_units")
  closed          Boolean  @default(false)
  reason          String?

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@id([inventoryItemId, date])
  @@map("inventory_day_overrides")
}

model BlackoutDate {
  id        String   @id @default(uuid(7)) @db.Uuid
  serviceId String   @map("service_id") @db.Uuid
  date      DateTime @db.Date
  reason    String?

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, date])
  @@map("blackout_dates")
}

/// Units taken by a booking: a hold (expires) or a committed reservation.
/// slot_capacity → slot_id; nightly → one row per night (night_date); rentals/assignments → period.
model InventoryReservation {
  id              String          @id @default(uuid(7)) @db.Uuid
  bookingId       String          @map("booking_id") @db.Uuid
  inventoryItemId String          @map("inventory_item_id") @db.Uuid
  slotId          String?         @map("slot_id") @db.Uuid
  nightDate       DateTime?       @map("night_date") @db.Date
  startsAt        DateTime?       @map("starts_at") @db.Timestamptz(3)
  endsAt          DateTime?       @map("ends_at") @db.Timestamptz(3)
  units           Int
  kind            ReservationKind
  expiresAt       DateTime?       @map("expires_at") @db.Timestamptz(3)
  releasedAt      DateTime?       @map("released_at") @db.Timestamptz(3)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  booking       Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem     @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  slot          AvailabilitySlot? @relation(fields: [slotId], references: [id], onDelete: Restrict)

  @@index([inventoryItemId, nightDate])
  @@index([inventoryItemId, startsAt, endsAt])
  @@index([expiresAt])
  @@index([bookingId])
  @@map("inventory_reservations")
}

// ──────────────────────────── Pricing ────────────────────────────

model PricePlan {
  id                   String       @id @default(uuid(7)) @db.Uuid
  serviceId            String       @map("service_id") @db.Uuid
  inventoryItemId      String?      @map("inventory_item_id") @db.Uuid
  name                 String       @db.VarChar(80)
  model                PricingModel
  baseAmount           Int          @map("base_amount")
  childAmount          Int?         @map("child_amount")
  perKmAmount          Int?         @map("per_km_amount")
  minimumFare          Int?         @map("minimum_fare")
  includedOccupancy    Int?         @map("included_occupancy")
  extraAdultAmount     Int?         @map("extra_adult_amount")
  minimumBillableUnits Int?         @map("minimum_billable_units")
  depositPerUnit       Int?         @map("deposit_per_unit")
  isActive             Boolean      @default(true) @map("is_active")
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  service       Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  seasonalRules SeasonalPriceRule[]

  @@index([serviceId])
  @@map("price_plans")
}

model SeasonalPriceRule {
  id                 String   @id @default(uuid(7)) @db.Uuid
  pricePlanId        String   @map("price_plan_id") @db.Uuid
  label              String   @db.VarChar(80)
  fromDate           DateTime @map("from_date") @db.Date
  toDate             DateTime @map("to_date") @db.Date
  daysOfWeek         Int[]    @default([]) @map("days_of_week")
  overrideUnitAmount Int?     @map("override_unit_amount")
  adjustmentBps      Int?     @map("adjustment_bps")
  priority           Int      @default(0)

  pricePlan PricePlan @relation(fields: [pricePlanId], references: [id], onDelete: Cascade)

  @@index([pricePlanId, fromDate, toDate])
  @@map("seasonal_price_rules")
}

/// Tax configuration per category (and optional price slab). Rates are set by finance after tax advice; nothing is hard-coded.
model TaxRule {
  id            String    @id @default(uuid(7)) @db.Uuid
  categoryId    String    @map("category_id") @db.Uuid
  code          String    @db.VarChar(24)
  label         String    @db.VarChar(80)
  rateBps       Int       @map("rate_bps")
  minUnitAmount Int?      @map("min_unit_amount")
  maxUnitAmount Int?      @map("max_unit_amount")
  validFrom     DateTime  @map("valid_from") @db.Timestamptz(3)
  validTo       DateTime? @map("valid_to") @db.Timestamptz(3)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId, validFrom])
  @@map("tax_rules")
}

// ─────────────────────── Trips & bookings ───────────────────────

/// Parent order for a multi-service itinerary. Not atomic: each booking has its own lifecycle.
model Trip {
  id            String     @id @default(uuid(7)) @db.Uuid
  reference     String     @unique @db.VarChar(16)
  userId        String?    @map("user_id") @db.Uuid
  /// Guest checkout contact (when userId is null).
  guestEmail    String?    @map("guest_email") @db.Citext
  guestPhone    String?    @map("guest_phone") @db.VarChar(16)
  title         String?    @db.VarChar(120)
  destinationId String?    @map("destination_id") @db.Uuid
  startDate     DateTime?  @map("start_date") @db.Date
  endDate       DateTime?  @map("end_date") @db.Date
  status        TripStatus @default(planning)
  couponId      String?    @map("coupon_id") @db.Uuid
  shareToken    String?    @unique @map("share_token") @db.VarChar(64)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  bookings Booking[]
  payments Payment[]

  @@index([userId, createdAt])
  @@map("trips")
}

model Booking {
  id                   String             @id @default(uuid(7)) @db.Uuid
  reference            String             @unique @db.VarChar(16)
  tripId               String             @map("trip_id") @db.Uuid
  travelerId           String?            @map("traveler_id") @db.Uuid
  providerId           String             @map("provider_id") @db.Uuid
  serviceId            String             @map("service_id") @db.Uuid
  pricePlanId          String             @map("price_plan_id") @db.Uuid
  status               BookingStatus      @default(draft)
  confirmationPolicy   ConfirmationPolicy @map("confirmation_policy")
  /// Request snapshot: dates, slot, units, guests, distance, pickup/drop.
  request              Json
  startsAt             DateTime           @map("starts_at") @db.Timestamptz(3)
  endsAt               DateTime           @map("ends_at") @db.Timestamptz(3)
  units                Int                @default(1)
  adults               Int                @default(1)
  children             Int                @default(0)
  /// Immutable price snapshot (quote lines) at the time of booking.
  quote                Json
  serviceSubtotal      Int                @map("service_subtotal")
  discount             Int                @default(0)
  discountFundedBy     FundingParty?      @map("discount_funded_by")
  taxableValue         Int                @map("taxable_value")
  serviceTax           Int                @map("service_tax")
  platformFee          Int                @default(0) @map("platform_fee")
  platformFeeTax       Int                @default(0) @map("platform_fee_tax")
  deposit              Int                @default(0)
  total                Int
  amountRefunded       Int                @default(0) @map("amount_refunded")
  /// Cancellation policy snapshot so later policy edits never change agreed terms.
  cancellationPolicy   Json               @map("cancellation_policy")
  holdExpiresAt        DateTime?          @map("hold_expires_at") @db.Timestamptz(3)
  providerRespondBy    DateTime?          @map("provider_respond_by") @db.Timestamptz(3)
  paymentDueBy         DateTime?          @map("payment_due_by") @db.Timestamptz(3)
  confirmedAt          DateTime?          @map("confirmed_at") @db.Timestamptz(3)
  completedAt          DateTime?          @map("completed_at") @db.Timestamptz(3)
  cancelledAt          DateTime?          @map("cancelled_at") @db.Timestamptz(3)
  cancellationReason   String?            @map("cancellation_reason")
  specialRequests      String?            @map("special_requests")
  ticketCodeHash       String?            @unique @map("ticket_code_hash") @db.VarChar(64)
  version              Int                @default(0)
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  trip          Trip                   @relation(fields: [tripId], references: [id], onDelete: Restrict)
  traveler      User?                  @relation("booking_traveler", fields: [travelerId], references: [id], onDelete: SetNull)
  provider      Provider               @relation(fields: [providerId], references: [id], onDelete: Restrict)
  service       Service                @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  guests        BookingGuest[]
  statusHistory BookingStatusHistory[]
  reservations  InventoryReservation[]
  assignments   BookingAssignment[]
  allocations   PaymentAllocation[]
  refunds       Refund[]
  settlement    BookingSettlement?
  review        Review?
  invoices      Invoice[]
  tickets       SupportTicket[]

  @@index([providerId, startsAt])
  @@index([providerId, status])
  @@index([travelerId, startsAt])
  @@index([status, holdExpiresAt])
  @@index([tripId])
  @@map("bookings")
}

model BookingGuest {
  id          String  @id @default(uuid(7)) @db.Uuid
  bookingId   String  @map("booking_id") @db.Uuid
  fullName    String  @map("full_name") @db.VarChar(120)
  age         Int?
  isLead      Boolean @default(false) @map("is_lead")
  phone       String? @db.VarChar(16)
  /// Rentals: licence number captured for the operator (masked in lists).
  licenceNumber String? @map("licence_number") @db.VarChar(32)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("booking_guests")
}

model BookingStatusHistory {
  id         String         @id @default(uuid(7)) @db.Uuid
  bookingId  String         @map("booking_id") @db.Uuid
  fromStatus BookingStatus? @map("from_status")
  toStatus   BookingStatus  @map("to_status")
  event      String         @db.VarChar(64)
  actorType  String         @map("actor_type") @db.VarChar(16)
  actorId    String?        @map("actor_id") @db.Uuid
  note       String?
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@map("booking_status_history")
}

/// A specific resource (cab, guide, boat) or staff member assigned to a booking. An exclusion constraint prevents double assignment.
model BookingAssignment {
  id              String    @id @default(uuid(7)) @db.Uuid
  bookingId       String    @map("booking_id") @db.Uuid
  inventoryItemId String?   @map("inventory_item_id") @db.Uuid
  memberId        String?   @map("member_id") @db.Uuid
  startsAt        DateTime  @map("starts_at") @db.Timestamptz(3)
  endsAt          DateTime  @map("ends_at") @db.Timestamptz(3)
  releasedAt      DateTime? @map("released_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  booking Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  member  ProviderMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@map("booking_assignments")
}

// ─────────────────────── Payments & finance ───────────────────────

/// One gateway order paying for one or more bookings of a trip.
model Payment {
  id               String        @id @default(uuid(7)) @db.Uuid
  tripId           String        @map("trip_id") @db.Uuid
  gateway          String        @db.VarChar(24)
  gatewayOrderId   String        @unique @map("gateway_order_id") @db.VarChar(64)
  gatewayPaymentId String?       @unique @map("gateway_payment_id") @db.VarChar(64)
  amount           Int
  currency         String        @default("INR") @db.VarChar(3)
  status           PaymentStatus @default(created)
  method           String?       @db.VarChar(24)
  failureReason    String?       @map("failure_reason")
  capturedAt       DateTime?     @map("captured_at") @db.Timestamptz(3)
  idempotencyKey   String        @unique @map("idempotency_key") @db.VarChar(80)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  trip        Trip                @relation(fields: [tripId], references: [id], onDelete: Restrict)
  allocations PaymentAllocation[]
  events      PaymentEvent[]
  refunds     Refund[]

  @@index([tripId])
  @@map("payments")
}

model PaymentAllocation {
  paymentId String @map("payment_id") @db.Uuid
  bookingId String @map("booking_id") @db.Uuid
  amount    Int

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@id([paymentId, bookingId])
  @@map("payment_allocations")
}

/// Raw, signature-verified gateway webhook events. The unique event id makes processing idempotent.
model PaymentEvent {
  id             String    @id @default(uuid(7)) @db.Uuid
  paymentId      String?   @map("payment_id") @db.Uuid
  gateway        String    @db.VarChar(24)
  gatewayEventId String    @map("gateway_event_id") @db.VarChar(80)
  type           String    @db.VarChar(64)
  payload        Json
  processedAt    DateTime? @map("processed_at") @db.Timestamptz(3)
  error          String?
  receivedAt     DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([gateway, gatewayEventId])
  @@map("payment_events")
}

model Refund {
  id              String          @id @default(uuid(7)) @db.Uuid
  bookingId       String          @map("booking_id") @db.Uuid
  paymentId       String          @map("payment_id") @db.Uuid
  amount          Int
  /// Breakdown from the refund calculator (service, tax, fee, deposit, bps, reason).
  computation     Json
  initiatedBy     RefundInitiator @map("initiated_by")
  status          RefundStatus    @default(requested)
  gatewayRefundId String?         @unique @map("gateway_refund_id") @db.VarChar(64)
  approvedBy      String?         @map("approved_by") @db.Uuid
  reason          String?
  idempotencyKey  String          @unique @map("idempotency_key") @db.VarChar(80)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([status])
  @@map("refunds")
}

model CommissionRule {
  id            String    @id @default(uuid(7)) @db.Uuid
  providerId    String?   @map("provider_id") @db.Uuid
  categoryKey   String?   @map("category_key") @db.VarChar(48)
  destinationId String?   @map("destination_id") @db.Uuid
  rateBps       Int       @map("rate_bps")
  fixedAmount   Int?      @map("fixed_amount")
  priority      Int       @default(0)
  validFrom     DateTime? @map("valid_from") @db.Timestamptz(3)
  validTo       DateTime? @map("valid_to") @db.Timestamptz(3)
  note          String?
  createdBy     String?   @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  provider Provider? @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("commission_rules")
}

/// Per-booking commission and provider earnings, computed when the booking is confirmed and adjusted by refunds.
model BookingSettlement {
  bookingId             String    @id @map("booking_id") @db.Uuid
  commissionRuleId      String?   @map("commission_rule_id") @db.Uuid
  providerServiceValue  Int       @map("provider_service_value")
  commission            Int
  commissionTax         Int       @map("commission_tax")
  withholdings          Json      @default("[]")
  serviceTaxPassThrough Int       @map("service_tax_pass_through")
  netPayout             Int       @map("net_payout")
  refundAdjustment      Int       @default(0) @map("refund_adjustment")
  /// Earliest date the amount may be paid out (after service completion + dispute window).
  eligibleOn            DateTime? @map("eligible_on") @db.Date
  payoutId              String?   @map("payout_id") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  payout  Payout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([payoutId])
  @@index([eligibleOn])
  @@map("booking_settlements")
}

model Payout {
  id               String       @id @default(uuid(7)) @db.Uuid
  providerId       String       @map("provider_id") @db.Uuid
  payoutAccountId  String       @map("payout_account_id") @db.Uuid
  periodStart      DateTime     @map("period_start") @db.Date
  periodEnd        DateTime     @map("period_end") @db.Date
  amount           Int
  status           PayoutStatus @default(scheduled)
  gatewayPayoutRef String?      @unique @map("gateway_payout_ref") @db.VarChar(64)
  failureReason    String?      @map("failure_reason")
  paidAt           DateTime?    @map("paid_at") @db.Timestamptz(3)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  provider      Provider            @relation(fields: [providerId], references: [id], onDelete: Restrict)
  payoutAccount PayoutAccount       @relation(fields: [payoutAccountId], references: [id], onDelete: Restrict)
  settlements   BookingSettlement[]

  @@unique([providerId, periodStart, periodEnd])
  @@map("payouts")
}

model Invoice {
  id        String   @id @default(uuid(7)) @db.Uuid
  number    String   @unique @db.VarChar(32)
  bookingId String   @map("booking_id") @db.Uuid
  kind      String   @db.VarChar(24) // traveler_service | platform_fee | commission | credit_note
  issuedTo  Json     @map("issued_to")
  lines     Json
  total     Int
  mediaId   String?  @map("media_id") @db.Uuid
  issuedAt  DateTime @default(now()) @map("issued_at") @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@map("invoices")
}

model Coupon {
  id            String       @id @default(uuid(7)) @db.Uuid
  code          String       @unique @db.Citext
  kind          CouponKind
  percentBps    Int?         @map("percent_bps")
  amount        Int?
  maxDiscount   Int?         @map("max_discount")
  minSubtotal   Int?         @map("min_subtotal")
  fundedBy      FundingParty @map("funded_by")
  providerId    String?      @map("provider_id") @db.Uuid
  categoryKey   String?      @map("category_key") @db.VarChar(48)
  destinationId String?      @map("destination_id") @db.Uuid
  maxRedemptions Int?        @map("max_redemptions")
  perUserLimit  Int          @default(1) @map("per_user_limit")
  redeemedCount Int          @default(0) @map("redeemed_count")
  validFrom     DateTime     @map("valid_from") @db.Timestamptz(3)
  validTo       DateTime     @map("valid_to") @db.Timestamptz(3)
  isActive      Boolean      @default(true) @map("is_active")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  redemptions CouponRedemption[]

  @@map("coupons")
}

model CouponRedemption {
  id        String   @id @default(uuid(7)) @db.Uuid
  couponId  String   @map("coupon_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  bookingId String   @unique @map("booking_id") @db.Uuid
  discount  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)

  @@index([couponId, userId])
  @@map("coupon_redemptions")
}

/// Client-supplied Idempotency-Key storage for booking/payment/refund mutations.
model IdempotencyKey {
  key          String   @id @db.VarChar(80)
  userId       String?  @map("user_id") @db.Uuid
  scope        String   @db.VarChar(64)
  requestHash  String   @map("request_hash") @db.VarChar(64)
  responseCode Int?     @map("response_code")
  responseBody Json?    @map("response_body")
  lockedUntil  DateTime? @map("locked_until") @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@map("idempotency_keys")
}

// ─────────────────────── Customer experience ───────────────────────

model Favourite {
  userId    String   @map("user_id") @db.Uuid
  serviceId String   @map("service_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([userId, serviceId])
  @@map("favourites")
}

/// Only completed bookings can be reviewed (one review per booking).
model Review {
  id         String       @id @default(uuid(7)) @db.Uuid
  bookingId  String       @unique @map("booking_id") @db.Uuid
  serviceId  String       @map("service_id") @db.Uuid
  providerId String       @map("provider_id") @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  rating     Int
  title      String?      @db.VarChar(120)
  body       String?
  status     ReviewStatus @default(published)
  response   String?
  respondedAt DateTime?   @map("responded_at") @db.Timestamptz(3)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([serviceId, status, createdAt])
  @@map("reviews")
}

model SavedTraveller {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  fullName  String   @map("full_name") @db.VarChar(120)
  age       Int?
  phone     String?  @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("saved_travellers")
}

model EmergencyContact {
  id           String   @id @default(uuid(7)) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  name         String   @db.VarChar(120)
  relationship String?  @db.VarChar(40)
  phone        String   @db.VarChar(16)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("emergency_contacts")
}

model NotificationTemplate {
  id        String              @id @default(uuid(7)) @db.Uuid
  event     String              @db.VarChar(64)
  channel   NotificationChannel
  locale    String              @default("en") @db.VarChar(8)
  subject   String?             @db.VarChar(200)
  body      String
  /// Provider-side template id (DLT template id for SMS in India, WhatsApp template name).
  externalTemplateId String?    @map("external_template_id") @db.VarChar(64)
  isActive  Boolean             @default(true) @map("is_active")
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([event, channel, locale])
  @@map("notification_templates")
}

model Notification {
  id          String              @id @default(uuid(7)) @db.Uuid
  userId      String?             @map("user_id") @db.Uuid
  event       String              @db.VarChar(64)
  channel     NotificationChannel
  recipient   String              @db.VarChar(254)
  payload     Json
  status      DeliveryStatus      @default(queued)
  attempts    Int                 @default(0)
  lastError   String?             @map("last_error")
  readAt      DateTime?           @map("read_at") @db.Timestamptz(3)
  sentAt      DateTime?           @map("sent_at") @db.Timestamptz(3)
  dedupeKey   String?             @unique @map("dedupe_key") @db.VarChar(160)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, channel, createdAt])
  @@index([status, createdAt])
  @@map("notifications")
}

model SupportTicket {
  id           String         @id @default(uuid(7)) @db.Uuid
  reference    String         @unique @db.VarChar(16)
  requesterId  String?        @map("requester_id") @db.Uuid
  assigneeId   String?        @map("assignee_id") @db.Uuid
  bookingId    String?        @map("booking_id") @db.Uuid
  providerId   String?        @map("provider_id") @db.Uuid
  category     TicketCategory
  priority     TicketPriority @default(normal)
  status       TicketStatus   @default(open)
  subject      String         @db.VarChar(200)
  /// Safety incidents: location and severity details.
  incident     Json?
  escalatedAt  DateTime?      @map("escalated_at") @db.Timestamptz(3)
  resolvedAt   DateTime?      @map("resolved_at") @db.Timestamptz(3)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  requester User?            @relation("ticket_requester", fields: [requesterId], references: [id], onDelete: SetNull)
  assignee  User?            @relation("ticket_assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  booking   Booking?         @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  provider  Provider?        @relation(fields: [providerId], references: [id], onDelete: SetNull)
  messages  SupportMessage[]

  @@index([status, priority, createdAt])
  @@index([requesterId])
  @@map("support_tickets")
}

model SupportMessage {
  id         String   @id @default(uuid(7)) @db.Uuid
  ticketId   String   @map("ticket_id") @db.Uuid
  authorId   String?  @map("author_id") @db.Uuid
  body       String
  isInternal Boolean  @default(false) @map("is_internal")
  attachments String[] @default([]) @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

// ───────────────────── Platform administration ─────────────────────

/// Append-only. Never updated or deleted by the application role.
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actorType  String   @map("actor_type") @db.VarChar(16)
  action     String   @db.VarChar(96)
  entityType String   @map("entity_type") @db.VarChar(48)
  entityId   String?  @map("entity_id") @db.VarChar(64)
  providerId String?  @map("provider_id") @db.Uuid
  before     Json?
  after      Json?
  ipAddress  String?  @map("ip_address") @db.Inet
  requestId  String?  @map("request_id") @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

model CmsPage {
  id             String    @id @default(uuid(7)) @db.Uuid
  slug           String    @unique @db.VarChar(160)
  kind           String    @db.VarChar(24) // home | legal | guide | blog | landing
  title          String    @db.VarChar(200)
  /// Structured content blocks rendered by the web app.
  blocks         Json
  status         CmsStatus @default(draft)
  seoTitle       String?   @map("seo_title") @db.VarChar(70)
  seoDescription String?   @map("seo_description") @db.VarChar(170)
  version        Int       @default(1)
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(3)
  updatedBy      String?   @map("updated_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("cms_pages")
}

model Faq {
  id            String    @id @default(uuid(7)) @db.Uuid
  destinationId String?   @map("destination_id") @db.Uuid
  categoryKey   String?   @map("category_key") @db.VarChar(48)
  question      String
  answer        String
  sortOrder     Int       @default(0) @map("sort_order")
  status        CmsStatus @default(draft)

  destination Destination? @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@map("faqs")
}

model Banner {
  id        String    @id @default(uuid(7)) @db.Uuid
  placement String    @db.VarChar(48)
  title     String    @db.VarChar(160)
  body      String?
  ctaLabel  String?   @map("cta_label") @db.VarChar(48)
  ctaHref   String?   @map("cta_href")
  mediaId   String?   @map("media_id") @db.Uuid
  startsAt  DateTime? @map("starts_at") @db.Timestamptz(3)
  endsAt    DateTime? @map("ends_at") @db.Timestamptz(3)
  sortOrder Int       @default(0) @map("sort_order")
  status    CmsStatus @default(draft)

  @@index([placement, status])
  @@map("banners")
}

model FeatureFlag {
  key         String   @id @db.VarChar(64)
  enabled     Boolean  @default(false)
  description String?
  /// Optional targeting: { roles?, destinationSlugs?, percentage? }
  rules       Json?
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("feature_flags")
}

model SystemSetting {
  key       String   @id @db.VarChar(96)
  value     Json
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("system_settings")
}
