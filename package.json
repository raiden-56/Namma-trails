{
  "name": "karnataka-tourism-marketplace",
  "private": true,
  "description": "Multi-vendor Karnataka tourism marketplace (working brand: Namma Trails)",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "pnpm --filter @kt/web dev",
    "dev:api": "pnpm --filter @kt/api dev",
    "build": "pnpm -r --workspace-concurrency=1 --filter=!. build",
    "typecheck": "pnpm -r --filter=!. typecheck",
    "test": "pnpm -r --filter=!. test",
    "db:up": "docker compose up -d postgres redis s3 mailpit",
    "db:migrate": "pnpm --filter @kt/api prisma:migrate",
    "db:seed": "pnpm --filter @kt/api db:seed",
    "test:e2e": "pnpm --filter @kt/web test:e2e",
    "db:seed:demo": "pnpm --filter @kt/api db:seed:demo",
    "db:reset:demo": "pnpm --filter @kt/api build && pnpm --filter @kt/api db:reset:demo"
  }
}
